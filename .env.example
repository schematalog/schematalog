# Local development configuration. Copy to `.env` (gitignored) and pick a backend.
# One variable configures the store: its scheme selects the backend, and any options
# travel as query parameters.

# --- SQLite (default): no external service, nothing to run. Good for `just serve`. ---
# Tables are created on first use, so there is no migration step. Omitting this line
# entirely gives the same backend, at ./schematalog.db.
SCHEMATALOG_STORAGE_URL=sqlite:///./db.sqlite3

# --- PostgreSQL (parity with production). Run `just up` first, then swap to this. ---
# The same compose database the integration lane uses.
# SCHEMATALOG_STORAGE_URL=postgresql://schematalog:schematalog@localhost:5432/schematalog

# --- Plain files, if you would rather read the store than query it. ---
# SCHEMATALOG_STORAGE_URL=file://storage_

# After pointing at a fresh database, populate it with sample schemas: `just seed`.
