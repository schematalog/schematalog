{# The label every link that leaves for a new tab carries. Visible text would repeat on
   four links in one footer, so it is announced rather than shown, and the arrow icon
   beside it is what a sighted reader sees. #}
{% macro new_tab_note() %}<span class="sr-only"> (opens in a new tab)</span>{% endmacro %}
