{# Inline SVG icons (Lucide, ISC-licensed paths).

   Inline rather than an icon font or a sprite sheet: there are a handful of them, they
   inherit `currentColor` and the surrounding font size, and they cost no extra request
   and no flash of unstyled glyph. `aria-hidden` on every one - each is decorative and
   sits beside its own label, so announcing it would only repeat the label. #}

{% macro _svg(paths, extra_class="") %}
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor"
     stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"
     class="inline-block h-[1.1em] w-[1.1em] shrink-0 align-[-0.15em] {{ extra_class }}">
    {% for d in paths %}<path d="{{ d }}"/>{% endfor %}
</svg>
{% endmacro %}

