{# Tailwind v4 + DaisyUI base; every page extends this. #}
{% import "_icons.html.jinja" as icon %}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" href="/static/schematalog-icon.png">
    {# Resolve the theme before the first paint, or the page renders light and then
       corrects itself in front of the reader. Inline and blocking for that reason: an
       external script, even a synchronous one, is a network round trip too late. The
       stored value is a *preference* ("auto" is stored as nothing at all); what lands
       on the element is always a concrete "light" or "dark", which is what DaisyUI and
       the generated code palette select on. Kept deliberately tiny - the island owns
       every other part of this. #}
    <script>
        (function () {
            var theme = "light";
            try {
                var stored = window.localStorage.getItem("schematalog-theme");
                theme = stored === "light" || stored === "dark"
                    ? stored
                    : window.matchMedia("(prefers-color-scheme: dark)").matches
                        ? "dark"
                        : "light";
            } catch (error) {
                /* Blocked site data: fall back to light rather than failing to paint. */
            }
            document.documentElement.dataset.theme = theme;
        })();
    </script>
    {{ vite_asset("src/styles/app.css") }}
    {% block head_extras %}{% endblock %}
    {# Page first, site last: a tab label truncates from the right, and the favicon
       already says which app this is - so the leading words have to be the ones that
       tell two tabs apart. A page with nothing to add (the home page) leaves the block
       empty and the separator goes with it. Capturing the block into a variable is what
       makes the separator conditional: rendering the block in place would commit to the
       " - " before knowing whether anything precedes it. #}
    {% set page %}{% block page_title %}{% endblock %}{% endset %}
    <title>{% if page %}{{ page }} - {% endif %}Schematalog</title>
</head>
<body class="min-h-screen flex flex-col bg-base-100 text-base-content">

    <header class="navbar bg-base-200 border-b border-base-300 px-4 gap-3">
        <div class="flex-1 flex items-center gap-3">
            {# The mark is a single ink on transparency, so it needs one file per theme -
               the dark one vanishes on a dark ground. Swapped in CSS rather than by the
               island so it is already correct at first paint. Only one carries the alt
               text; the other is decorative, or a screen reader would announce the name
               twice. #}
            <a href="{{ url_for('homepage') }}" class="flex items-center gap-2">
                <img class="theme-when-light" width="36" height="36"
                     src="/static/schematalog-icon.png" alt="Schematalog">
                <img class="theme-when-dark" width="36" height="36"
                     src="/static/schematalog-icon-white.png" alt="" aria-hidden="true">
                <span class="text-xl font-semibold">Schematalog</span>
            </a>
        </div>
        <nav class="flex-none flex items-center gap-2 text-sm">
            {# Hidden until the island reveals it: the control cannot work without
               JavaScript, and a button that does nothing is worse than no button. #}
            <div class="dropdown dropdown-end" data-theme-control hidden>
                <div tabindex="0" role="button" class="btn btn-sm btn-ghost"
                     aria-label="Colour theme">
                    <span class="theme-when-light">{{ icon.sun() }}</span>
                    <span class="theme-when-dark">{{ icon.moon() }}</span>
                </div>
                <ul tabindex="0" role="radiogroup" aria-label="Colour theme"
                    class="dropdown-content menu bg-base-200 rounded-box z-10 mt-1 w-36 p-2 shadow">
                    <li><button type="button" role="radio" aria-checked="false"
                        data-theme-choice="auto">{{ icon.monitor() }}Auto</button></li>
                    <li><button type="button" role="radio" aria-checked="false"
                        data-theme-choice="light">{{ icon.sun() }}Light</button></li>
                    <li><button type="button" role="radio" aria-checked="false"
                        data-theme-choice="dark">{{ icon.moon() }}Dark</button></li>
                </ul>
            </div>
            <a class="btn btn-sm btn-primary" href="{{ url_for('schemas_publish') }}">Publish</a>
        </nav>
    </header>

    <main class="flex-1 w-full max-w-5xl mx-auto px-4 py-8">
    {% block content %}{% endblock %}
    </main>

    {# Everything the app serves about itself, in one place. All four open a new tab, and
       each says so - the arrow icon for a sighted reader, `_icons.new_tab_note` for a
       screen reader. Reference material is the case where a new tab is the right default
       even for a same-origin page: you consult it *beside* what you were reading, and
       coming back should not mean re-finding your place. #}
    <footer class="footer footer-center gap-2 border-t border-base-300 p-4 text-xs">
        <nav class="flex flex-wrap items-center justify-center gap-x-5 gap-y-2">
            <a class="link link-hover inline-flex items-center gap-1.5"
               href="{{ url_for('swagger_ui_html') }}" target="_blank" rel="noopener">
                {{ icon.braces() }}API reference{{ icon.external() }}{{ icon.new_tab_note() }}</a>
            <a class="link link-hover inline-flex items-center gap-1.5"
               href="{{ url_for('openapi') }}" target="_blank" rel="noopener">
                {{ icon.file() }}OpenAPI spec{{ icon.external() }}{{ icon.new_tab_note() }}</a>
            <a class="link link-hover inline-flex items-center gap-1.5"
               href="{{ docs_url }}" target="_blank" rel="noopener">
                {{ icon.book() }}Read the Docs{{ icon.external() }}{{ icon.new_tab_note() }}</a>
            <a class="link link-hover inline-flex items-center gap-1.5"
               href="{{ repository_url }}" target="_blank" rel="noopener">
                {{ icon.github() }}GitHub{{ icon.external() }}{{ icon.new_tab_note() }}</a>
        </nav>
        <span class="opacity-60">version {{ app_version }}{% if version_date %} {{ version_date }}{% endif %}</span>
    </footer>

    {{ vite_asset("src/islands/theme.ts") }}
    {% block foot_extras %}{% endblock %}
</body>
</html>