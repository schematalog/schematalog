{% extends "app_base.html.jinja" %}
{% block page_title %}All schemas{% endblock %}
{% block content %}

<div class="mb-4 flex items-start justify-between gap-4">
    <div>
        <h1 class="text-2xl font-bold">Schemas</h1>
    </div>
    <a class="btn btn-sm btn-primary shrink-0" href="{{ url_for('schemas_publish') }}">Publish a schema</a>
</div>

{# A plain GET form: it searches without JavaScript, the query lands in the URL so a
   search can be linked and bookmarked, and the back button behaves. #}
<form method="get" action="{{ url_for('schemas_list') }}" role="search" class="mb-6 flex gap-2">
    <label for="schema-search" class="sr-only">Search schemas by name</label>
    <input type="search" id="schema-search" name="q" value="{{ query }}"
           placeholder="Search by name" autocomplete="off"
           class="input input-sm input-bordered w-full max-w-sm">
    <button type="submit" class="btn btn-sm">Search</button>
    {% if query %}
    <a class="btn btn-sm btn-ghost" href="{{ url_for('schemas_list') }}">Clear</a>
    {% endif %}
</form>

{% if schemas %}
<div class="grid gap-4 sm:grid-cols-2">
    {% for schema in schemas %}
    <a href="{{ url_for('schemas_detail', schema_name=schema.name) }}"
       class="card bg-base-100 border border-base-300 shadow-sm transition-colors hover:border-primary">
        <div class="card-body gap-2 p-4">
            <div class="flex items-start justify-between gap-2">
                <h2 class="card-title break-all text-base">{{ schema.name }}</h2>
                <span class="badge badge-ghost badge-sm shrink-0">latest v{{ schema.version }}</span>
            </div>
            <div class="flex flex-wrap items-center gap-2">
                {% if schema.deprecated %}<span class="badge badge-sm badge-warning">deprecated</span>{% endif %}
            </div>
            <p class="text-xs opacity-60">Published {{ schema.published_on|datetime }}</p>
        </div>
    </a>
    {% endfor %}
</div>
{% else %}
<div class="py-16 text-center opacity-70">
    {# Distinguish "your search found nothing" from "there is nothing here" - the same
       empty page otherwise tells a first-time visitor the registry is broken. #}
    {% if not query_is_valid %}
    <p class="text-lg">That is not something a schema name could contain.</p>
    <p class="mt-2 text-sm">
        Names use letters, digits, <code>.</code>, <code>-</code> and <code>_</code>,
        so a search containing anything else - a space, say - cannot match.
    </p>
    <p class="mt-2 text-sm">
        <a class="link" href="{{ url_for('schemas_list') }}">Show every schema</a>
    </p>
    {% elif query %}
    <p class="text-lg">No schema name contains &ldquo;{{ query }}&rdquo;.</p>
    <p class="mt-2 text-sm">
        <a class="link" href="{{ url_for('schemas_list') }}">Show every schema</a>
    </p>
    {% else %}
    <p class="text-lg">No schemas yet.</p>
    {% endif %}
</div>
{% endif %}

{% endblock %}