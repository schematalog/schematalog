{% extends "app_base.html.jinja" %}
{% block page_title %}All Schemas{% endblock %}
{% block content %}

<div class="mb-6 flex items-start justify-between gap-4">
    <div>
        <h1 class="text-2xl font-bold">Schemas</h1>
    </div>
    <a class="btn btn-sm btn-primary shrink-0" href="{{ url_for('schemas_publish') }}">Publish a schema</a>
</div>

{% if schemas %}
<div class="grid gap-4 sm:grid-cols-2">
    {% for schema in schemas %}
    <a href="{{ url_for('schemas_detail', schema_name=schema.name) }}"
       class="card bg-base-100 border border-base-300 shadow-sm transition-colors hover:border-primary">
        <div class="card-body gap-2 p-4">
            <div class="flex items-start justify-between gap-2">
                <h2 class="card-title break-all text-base">{{ schema.name }}</h2>
                <span class="badge badge-ghost badge-sm shrink-0">latest v{{ schema.version }}</span>
            </div>
            <div class="flex flex-wrap items-center gap-2">
                {% if schema.deprecated %}<span class="badge badge-sm badge-warning">deprecated</span>{% endif %}
            </div>
            <p class="text-xs opacity-60">Published {{ schema.published_on|datetime }}</p>
        </div>
    </a>
    {% endfor %}
</div>
{% else %}
<div class="py-16 text-center opacity-70">
    <p class="text-lg">No schemas yet.</p>
</div>
{% endif %}

{% endblock %}